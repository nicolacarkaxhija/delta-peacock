{
  "$id": "https://raw.githubusercontent.com/nicolacarkaxhija/delta-peacock/main/schema/delta-peacock.config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "default": {},
      "type": "object",
      "properties": {
        "provider": {
          "default": "anthropic",
          "type": "string",
          "enum": [
            "anthropic",
            "bedrock",
            "openrouter",
            "openai-compatible"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "review": {
      "default": {},
      "type": "object",
      "properties": {
        "target": {
          "default": "main",
          "type": "string",
          "minLength": 1
        },
        "guidelinesDir": {
          "default": "guidelines",
          "type": "string",
          "minLength": 1
        },
        "guidelinesRef": {
          "default": "target",
          "type": "string",
          "minLength": 1
        },
        "packs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fetchTarget": {
          "default": true,
          "type": "boolean"
        },
        "lastReviewedCommit": {
          "type": "string",
          "minLength": 1
        },
        "include": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxDiffBytes": {
          "default": 1000000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "confidenceFloor": {
          "default": 0.5,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "generalPass": {
          "default": false,
          "type": "boolean"
        },
        "observationSeverityCap": {
          "default": "MINOR",
          "type": "string",
          "enum": [
            "BLOCKER",
            "CRITICAL",
            "MAJOR",
            "MINOR",
            "INFO"
          ]
        },
        "maxProposedGuidelines": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "baselinePath": {
          "default": "delta-peacock.baseline.json",
          "type": "string",
          "minLength": 1
        },
        "language": {
          "default": "en",
          "type": "string",
          "minLength": 2
        },
        "windowTokens": {
          "default": 100000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "default": {},
      "type": "object",
      "properties": {
        "failOn": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "BLOCKER",
            "CRITICAL",
            "MAJOR",
            "MINOR",
            "INFO"
          ]
        }
      },
      "additionalProperties": false
    },
    "output": {
      "default": {},
      "type": "object",
      "properties": {
        "report": {
          "type": "string",
          "minLength": 1
        },
        "sarifPath": {
          "type": "string",
          "minLength": 1
        },
        "codeQualityPath": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "default": {},
      "type": "object",
      "properties": {
        "patterns": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "pattern"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "scm": {
      "default": {},
      "type": "object",
      "properties": {
        "provider": {
          "default": "local",
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "bitbucket",
            "local"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullRequest": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "commitStatus": {
          "default": true,
          "type": "boolean"
        },
        "comments": {
          "default": true,
          "type": "boolean"
        },
        "codeInsights": {
          "default": false,
          "type": "boolean"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "dryRun": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "cost": {
      "default": {},
      "type": "object",
      "properties": {
        "rateInputPer1M": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "rateOutputPer1M": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "rateCacheReadPer1M": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "rateCacheWritePer1M": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "rateEmbedPer1M": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "maxPerReview": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "monthlyCap": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "spendSource": {
          "default": "counter",
          "type": "string",
          "enum": [
            "counter",
            "aws-cost-explorer"
          ]
        },
        "counterPath": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "context": {
      "default": {},
      "type": "object",
      "properties": {
        "provider": {
          "default": "repo_map",
          "type": "string",
          "enum": [
            "none",
            "repo_map",
            "agentic",
            "rag"
          ]
        },
        "providers": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "repo_map",
              "agentic",
              "rag"
            ]
          }
        },
        "maxTokens": {
          "default": 4000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxToolRounds": {
          "default": 6,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "rag": {
          "default": {},
          "type": "object",
          "properties": {
            "backend": {
              "default": "tfidf",
              "type": "string",
              "enum": [
                "tfidf",
                "embeddings"
              ]
            },
            "provider": {
              "default": "openai-compatible",
              "type": "string",
              "enum": [
                "openai-compatible",
                "bedrock"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "baseUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ensemble": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "members": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "anthropic",
                  "bedrock",
                  "openrouter",
                  "openai-compatible"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "baseUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "provider",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "mode": {
          "default": "union",
          "type": "string",
          "enum": [
            "union",
            "judge"
          ]
        },
        "judge": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "anthropic",
                "bedrock",
                "openrouter",
                "openai-compatible"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "baseUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "provider",
            "id"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "calibration": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "anthropic",
                "bedrock",
                "openrouter",
                "openai-compatible"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "baseUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "provider",
            "id"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cache": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "ttlHours": {
          "default": 24,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "stats": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "path": {
          "default": "delta-peacock.stats.jsonl",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
