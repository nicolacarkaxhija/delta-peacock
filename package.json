{
  "name": "delta-peacock",
  "version": "0.11.0",
  "description": "Guideline-anchored, provider-agnostic PR reviewer. Your rules, any SCM, any LLM.",
  "keywords": [
    "code-review",
    "pull-request",
    "ai",
    "llm",
    "guidelines",
    "ci"
  ],
  "license": "Apache-2.0",
  "author": "Nicola Carkaxhija",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolacarkaxhija/delta-peacock.git"
  },
  "homepage": "https://github.com/nicolacarkaxhija/delta-peacock#readme",
  "bugs": {
    "url": "https://github.com/nicolacarkaxhija/delta-peacock/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.0",
  "bin": {
    "delta-peacock": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "packs",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "schema:update": "vitest run tests/config-schema.test.ts -u",
    "findings:schema": "node scripts/findings-schema.mjs",
    "prepack": "tsup",
    "pack:bundled": "sh scripts/pack-bundled.sh",
    "prepare": "husky",
    "spell": "cspell --no-progress --no-summary ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "cspell": "^9.8.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.14",
    "@ai-sdk/anthropic": "^4.0.10",
    "@ai-sdk/openai": "^4.0.9",
    "@aws-sdk/client-cost-explorer": "^3.1082.0",
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "ai": "^7.0.18",
    "commander": "^15.0.0",
    "picomatch": "^4.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "bundleDependencies": [
    "@ai-sdk/amazon-bedrock",
    "@ai-sdk/anthropic",
    "@ai-sdk/openai",
    "@aws-sdk/client-cost-explorer",
    "acorn",
    "acorn-walk",
    "ai",
    "commander",
    "picomatch",
    "yaml",
    "zod"
  ],
  "semgrep": {
    "version": "1.183.0",
    "wheels": {
      "darwin-arm64": {
        "url": "https://files.pythonhosted.org/packages/18/03/537cec5ec8c5c75b10f6a7978a624f605dddfd28232687378212098ae924/semgrep-1.183.0-cp310.cp311.cp312.cp313.cp314.py310.py311.py312.py313.py314-none-macosx_11_0_arm64.whl",
        "sha256": "fa13eb666ea84cb9d11cea244cb106fefde57ffe51e251a0f91c7de1c4da0944"
      },
      "linux-x64": {
        "url": "https://files.pythonhosted.org/packages/c5/fd/85ac31a5ec53feee54ebdce933ab1c94af81695a2b244b0baefdbcdba92a/semgrep-1.183.0-cp310.cp311.cp312.cp313.cp314.py310.py311.py312.py313.py314-none-manylinux_2_34_x86_64.whl",
        "sha256": "f36115c4d0cb43056ceb308273421a2f6a35e055e7e029601e130850f836646e"
      },
      "linux-arm64": {
        "url": "https://files.pythonhosted.org/packages/2b/51/c3ee0c54dd7062c4452ea293d1ab1248d96d6c2d0fc08b37107fce8a2332/semgrep-1.183.0-cp310.cp311.cp312.cp313.cp314.py310.py311.py312.py313.py314-none-manylinux_2_34_aarch64.whl",
