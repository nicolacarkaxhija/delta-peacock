<iscontent type="text/html" charset="UTF-8" compact="true" />

<isset name="currentLocaleID" value="${request.getLocale()}" scope="page" />
<isset name="yotpoHelper" value="${require('*/cartridge/scripts/yotpo/yotpoHelper')}" scope="page" />
<isset
    name="consentManagementProviderImpl"
    value="${require('*/cartridge/scripts/util/ProviderMgr').getConsentManagementProvider()}"
    scope="page"
/>
<isset name="consentManagementProvider"
    value="${consentManagementProviderImpl && consentManagementProviderImpl.getActualProvider()}"
    scope="page" />

<isif
    condition="${yotpoHelper.isYotpoEnabled(currentLocaleID) && yotpoHelper.isConversionTrackingEnabled(currentLocaleID)}">
    <isset name="appKey" value="${yotpoHelper.getAppKey(currentLocaleID)}" scope="page" />
    <isif condition="${!empty(pdict.order)}">
        <script
            <isif condition="${consentManagementProvider && consentManagementProvider.getWidgetName() === 'usercentricsCM'}">
                type="text/plain" data-usercentrics="Yotpo"
            </isif>
        >
            (function e(){
                var e=document.createElement("script");
                    e.type="text/javascript",
                    e.async=true,
                    e.src=`//staticw2.yotpo.com/${appKey}/widget.js`;
                var t = document.getElementsByTagName("script")[0];
                t.parentNode.insertBefore(e,t);
            })();
        </script>
        <script>
            yotpoTrackConversionData = {orderId: ${pdict.order.orderNumber}, orderAmount: ${pdict.order.totals.grandTotal.value}, orderCurrency: '${request.session.currency.currencyCode}'}
        </script>
        <noscript>
            <img
                src="//api.yotpo.com/conversion_tracking.gif?app_key=${appKey}&order_id=${pdict.order.orderNumber}&order_amount=${pdict.order.totals.grandTotal.value}&order_currency=${request.session.currency.currencyCode}"
                width="1"
                height="1"
                alt="${Resource.msg('img.alt.yotpo.tracking', 'imgAltText', null)}"
            >
        </noscript>
    </isif>
</isif>
