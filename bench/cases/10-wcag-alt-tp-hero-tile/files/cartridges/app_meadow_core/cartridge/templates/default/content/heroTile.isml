<iscontent type="text/html" charset="UTF-8" compact="true"/>

<isif condition="${!empty(pdict.heroImage)}">
    <section class="c-hero_tile">
        <img class="c-hero_tile-media" src="${URLUtils.staticURL('/images/hero/' + pdict.heroImage)}" width="960" height="540" loading="lazy" />
    </section>
</isif>
