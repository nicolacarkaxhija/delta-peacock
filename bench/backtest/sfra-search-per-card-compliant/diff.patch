@@ -1,3 +1,15 @@
 'use strict';
 
-module.exports = {};
+var searchHelpers = require('*/cartridge/scripts/search/searchHelpers');
+
+/** Cards whose category still has products, from one search over the parent. */
+function visibleCards(parentId, cards) {
+    var search = searchHelpers.createVisibleSearch(parentId);
+    var counts = {};
+    search.refinements.getNextLevelCategoryRefinementValues(search.category).toArray().forEach(function (value) {
+        counts[value.value] = value.hitCount;
+    });
+    return cards.filter(function (card) { return counts[card.categoryId] > 0; });
+}
+
+module.exports = { visibleCards: visibleCards };
