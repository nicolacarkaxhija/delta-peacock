+'use strict';
+
+var WidgetsOrder = require('app_shop_widgets/cartridge/models/order');
+
+function readGiftWrap(container) {
+    return container.custom.giftWrap === true;
+}
+
+function OrderModel(container, options) {
+    var order = new WidgetsOrder(container, options);
+    order.giftWrap = readGiftWrap(container);
+    return order;
+}
+
+module.exports = OrderModel;
