 'use strict';
 
-module.exports = {};
+function isOrderable(product, quantity) {
+    return product.online && product.availabilityModel.isOrderable(quantity);
+}
+
+/** Whether a gift pack bundle can be bought. */
+function isPackPurchasable(bundle) {
+    return isOrderable(bundle, 1) && bundle.bundledProducts.toArray().every(function (product) {
+        return isOrderable(product, bundle.getBundledProductQuantity(product).value);
+    });
+}
+
+module.exports = { isPackPurchasable: isPackPurchasable };
