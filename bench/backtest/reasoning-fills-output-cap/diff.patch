+++ b/src/panels/panel0.js
@@ -0,0 +1,7 @@
+import { logger } from "./logger.js";
+
+export function panelStep0(state) {
+  const visible = (state.items ?? []).slice(0, 2);
+  logger.info("panel step 0");
+  return { ...state, visible };
+}
