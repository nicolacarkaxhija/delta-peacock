+'use strict';
+
+const { expect } = require('chai');
+const decorate = require('../../../../../../cartridges/app_shop_core/cartridge/models/productLineItem/decorators/packSize');
+
+describe('packSize decorator', function () {
+    it('decorates the pack', function () {
+        const line = {};
+        decorate(line, { custom: { isGiftPack: true, sizeName: 'EU', gender: 'women' } });
+        expect(line.size).to.equal('EU');
+        expect(line.gender).to.equal('women');
+        expect(Object.keys(line)).to.have.length(2);
+    });
+});
