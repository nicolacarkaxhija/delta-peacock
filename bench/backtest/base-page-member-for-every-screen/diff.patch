diff --git a/screens/base.ts b/screens/base.ts
index e6bc1bb..ccd47c7 100644
--- a/screens/base.ts
+++ b/screens/base.ts
@@ -7,4 +7,14 @@ export class BaseScreen {
   heading(): Locator {
     return this.page.getByRole('heading', { level: 1 });
   }
+
+  /** The editable body every screen renders under its heading. */
+  bodyContent(): Locator {
+    return this.page.getByTestId('body_content');
+  }
+
+  /** Waits until the requests a screen fires after load have answered. */
+  async waitForQuietNetwork(): Promise<void> {
+    await this.page.waitForLoadState('networkidle');
+  }
 }
