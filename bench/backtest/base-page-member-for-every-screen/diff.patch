diff --git a/tests/smoke/every-screen.spec.ts b/tests/smoke/every-screen.spec.ts
new file mode 100644
index 0000000..07bc6d1
--- /dev/null
+++ b/tests/smoke/every-screen.spec.ts
@@ -0,0 +1,10 @@
+import { expect, test } from '../fixtures';
+import { allScreens } from '../screens';
+
+for (const name of allScreens) {
+  test(`${name} loads without a console error`, async ({ app, consoleErrors }) => {
+    const screen = await app.open(name);
+    await screen.waitForQuietNetwork();
+    expect(consoleErrors()).toEqual([]);
+  });
+}
