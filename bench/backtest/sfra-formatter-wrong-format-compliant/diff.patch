diff --git a/cartridges/app_shop_core/cartridge/models/productLineItem/decorators/packSize.js b/cartridges/app_shop_core/cartridge/models/productLineItem/decorators/packSize.js
new file mode 100644
index 0000000..8eac3b1
--- /dev/null
+++ b/cartridges/app_shop_core/cartridge/models/productLineItem/decorators/packSize.js
@@ -0,0 +1,10 @@
+'use strict';
+
+var jpSizeFormatter = require('*/cartridge/scripts/formatters/jpSizeFormatter');
+var sizeTables = require('*/cartridge/scripts/formatters/sizeTables');
+
+module.exports = function (line, product) {
+    // sizeName is EU;UK, the formatter expects JP;EU
+    var eu = product.custom.sizeName.split(';')[0];
+    line.size = jpSizeFormatter(sizeTables.euToJp(eu) + ';' + eu);
+};
diff --git a/cartridges/app_shop_core/cartridge/scripts/formatters/jpSizeFormatter.js b/cartridges/app_shop_core/cartridge/scripts/formatters/jpSizeFormatter.js
new file mode 100644
index 0000000..b76fa3d
--- /dev/null
+++ b/cartridges/app_shop_core/cartridge/scripts/formatters/jpSizeFormatter.js
@@ -0,0 +1,12 @@
+'use strict';
+
+/**
+ * Formats a Japanese size label.
+ * @param {string} size - "JP;EU", for example "25;39"
+ */
+function jpSizeFormatter(size) {
+    var parts = size.split(';');
+    return parts[0] + ' cm (EU ' + parts[1] + ')';
+}
+
+module.exports = jpSizeFormatter;
