+import { escape } from "../escape.js";
+
+export function facetList(model) {
+  const totals = require("../totals.js");
+  return model.facets.map((facet) => {
+    const isColor = facet.id.indexOf("color") > -1;
+    return `<li class="${isColor ? "swatch" : "text"}">${escape(facet.label)} ${totals.count(facet)}</li>`;
+  });
+}
