@@ -0,0 +1,8 @@
+import { formatDate } from "./format.js";
+
+export function receipt(order) {
+  const shown = `${order.placed.getDate()}.${order.placed.getMonth() + 1}`;
+  const stamp = order.placed.toISOString();
+  const due = formatDate(order.due);
+  return { text: `Placed ${shown}, due ${due}`, file: `receipt-${stamp}.json` };
+}
